{
  "name": "ballshooter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "캐주얼 동물 볼슈터 + 가방 로그라이크 (PixiJS, 세로 모바일)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node tools/smoke.mjs",
    "gen:assets": "node tools/gen-assets.mjs",
    "gen:sfx": "node tools/gen-sfx.mjs"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
